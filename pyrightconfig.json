{
  "extraPaths": ["./apps"],
  "venvPath": ".",
  "venv": "venv",
  "stubPath": "./typings",
  "typeCheckingMode": "basic",
  "reportMissingTypeStubs": false,
  "reportMissingModuleSource": false,
  "reportMissingImports": false,
  "reportDeprecated": "none",
  "useLibraryCodeForTypes": true,
  "ignore": [
    "venv/**"
  ]
}